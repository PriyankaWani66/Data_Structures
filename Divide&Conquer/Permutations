//Permutations of a string
#include<iostream>
using namespace std;

void PermutationsOfString(string& str,int i)
{
    //B.C
    if(i>=str.length())
    {
        cout<<str<<" ";
        return;
    }

    //Processing i=0 to n and j= i to n
    for(int j = i;j<str.length();j++)
    {
        swap(str[i],str[j]);
    }

    //Recursion
    PermutationsOfString(str,i+1);

    //Backtracking ==> to recreate original string because string is pass by reference
    swap(str[i],str[j]);
    


}
int main()
{
    string str = "abc";
    int i = 0;
    PermutationsOfString(str,i);
}